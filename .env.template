# Copy this file to .env and fill in your values

# Anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here
LOG_LEVEL=INFO

# TiDB (local container — default matches docker/tidb-compose.yml)
TIDB_HOST=127.0.0.1
TIDB_PORT=4000
TIDB_USER=root
TIDB_PASSWORD=
TIDB_DB=agent_memory

# Messenger — set at least one channel
# LINE Messaging API (LINE Notify was discontinued 2025-03-31)
# Setup: https://developers.line.biz/ → Create Messaging API channel → Issue Channel access token
LINE_CHANNEL_ACCESS_TOKEN=   # long-lived token from LINE Developers console
LINE_USER_ID=                # your LINE User ID (add the bot as friend, then check via webhook or console)
# Telegram
TELEGRAM_BOT_TOKEN=          # from @BotFather  (format: 123456:ABC-...)
TELEGRAM_CHAT_ID=            # personal chat_id or group id
