# AI Agent Studio environment template
# Copy to .env (mode 600) on the deployment host and fill in real values.
# Generate random tokens with: openssl rand -hex 32

# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── TiDB (local docker compose; host-bound to 127.0.0.1) ──────────────────────
TIDB_HOST=127.0.0.1
TIDB_PORT=4000
TIDB_USER=root
TIDB_PASSWORD=
TIDB_DB=agent_memory

# ── LINE Messaging API ────────────────────────────────────────────────────────
# Channel access token from LINE Developers Console → Messaging API channel
LINE_CHANNEL_ACCESS_TOKEN=
# Owner's LINE userId (default recipient for push when not multi-user)
LINE_USER_ID=
# Channel secret (used by line_webhook.py to verify HMAC signature on inbound)
# REQUIRED — webhook now rejects requests when this is empty
LINE_WEBHOOK_SECRET=

# ── Telegram (optional; if empty, alert_runner falls back to LINE) ────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── MCP authentication tokens (any random secret) ─────────────────────────────
MCP_WRITE_TOKEN=
MCP_NOTIFY_TOKEN=

# ── Snapshot integrity HMAC (optional) ────────────────────────────────────────
SNAPSHOT_HMAC_KEY=

# ── Multi-agent shadow mode (Phase 1) ─────────────────────────────────────────
# Comma-separated list of agent names that should ALSO run the v2 shadow
# profile in parallel (production still uses v1 active output). Empty = off.
# Currently supported pilots: tech_analyst, portfolio_manager
SHADOW_AGENTS=

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
